# ==========================================
# Kofrim — Exemplo de Variaveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# ==========================================

# Configuracoes do Django
DEBUG=False
SECRET_KEY=gere_uma_chave_segura_aqui_exemplo_django_insecure_ou_com_secrets
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://api.seu-dominio.com

# Seguranca HTTPS em Producao (opcional)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Banco de Dados PostgreSQL
DB_NAME=kofrim
DB_USER=postgres
DB_PASSWORD=sua_senha_postgresql
DB_HOST=localhost
DB_PORT=5432

# Google Gemini (Google AI Studio)
GEMINI_API_KEY=sua_api_key_do_google_ai_studio

# WhatsApp Cloud API (Meta for Developers)
# Token customizado definido por voce no webhook da Meta
WHATSAPP_VERIFY_TOKEN=seu_verify_token_definido_no_painel_meta

# App Secret do seu aplicativo no Meta for Developers (usado para validar X-Hub-Signature-256)
WHATSAPP_APP_SECRET=seu_app_secret_da_meta

# Token de acesso da Meta (Graph API)
WHATSAPP_ACCESS_TOKEN=seu_whatsapp_access_token_da_meta

# ID do numero de telefone no Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_da_meta

# Processamento Assincrono do Webhook
# Se True: responde HTTP 200 a Meta imediatamente e processa o Gemini em segundo plano
# Se False: processa de forma sincrona antes de responder (recomendado para testes/Insomnia)
WEBHOOK_ASSINCRONO=False
